FROM ghcr.io/prefix-dev/pixi:latest

ARG BCALM_VERSION

RUN pixi global install --environment bcalm --expose R --expose Rscript \
    "r-bcalm==${BCALM_VERSION}" r-ggplot2 r-argparse r-dplyr r-tidyr r-tibble \
    -c conda-forge -c bioconda

RUN Rscript -e "library(BCalm); library(mpra); library(ggplot2); library(argparse); \
    library(dplyr); library(tidyr); library(tibble)"
